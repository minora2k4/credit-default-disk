# Tên project Compose: tiền tố cho tên container, volume, network
COMPOSE_PROJECT_NAME=credit

# --- Version image (đã kiểm tra, phát hành trên 2 tuần) ---
HADOOP_IMAGE=apache/hadoop:3.4.2
KAFKA_IMAGE=apache/kafka:4.2.2
SPARK_IMAGE=apache/spark:4.1.3-python3
POSTGRES_IMAGE=postgres:17.11-alpine
GRAFANA_IMAGE=grafana/grafana-oss:12.4.3
KAFKA_UI_IMAGE=kafbat/kafka-ui:v1.5.0

# --- Port publish ra host: chỉ bind 127.0.0.1 để máy khác trong LAN không truy cập được ---
BIND_ADDR=127.0.0.1
HDFS_UI_PORT=9870
SPARK_MASTER_UI_PORT=8080
SPARK_WORKER_UI_PORT=8081
SPARK_DRIVER_UI_PORT=4040
JUPYTER_PORT=8888
KAFKA_EXTERNAL_PORT=29092
KAFKA_UI_PORT=8089
POSTGRES_PORT=5432
GRAFANA_PORT=3000

# KAFKA_CLUSTER_ID: sẽ thêm ở bước 2.1 (giai đoạn Kafka)
KAFKA_CLUSTER_ID = uGiaEeUeTAqUqih8x3D23g

# uid/gid của bạn trên host, để container ghi file vào work/ với đúng chủ sở hữu
HOST_UID=1000
HOST_GID=1000
