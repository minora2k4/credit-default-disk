# Cấu hình HDFS cho image apache/hadoop.
# Quy ước của image: <TÊN-FILE>.<ĐUÔI>_<khóa> = <giá trị>
#   ví dụ HDFS-SITE.XML_dfs.replication=1 -> sinh thẻ <property> trong hdfs-site.xml lúc container khởi động.

# Địa chỉ mặc định của HDFS: nhờ đó gõ `hdfs dfs -ls /datalake` thay vì URL đầy đủ
CORE-SITE.XML_fs.defaultFS=hdfs://namenode:8020

# Số bản sao mỗi block. Cụm 1 DataNode nên đặt 1 (lab sẽ đổi bằng `-setrep`)
HDFS-SITE.XML_dfs.replication=1
# Địa chỉ RPC mà DataNode/client kết nối tới NameNode
HDFS-SITE.XML_dfs.namenode.rpc-address=namenode:8020
# Nơi lưu metadata (fsimage + edits) của NameNode và block của DataNode, nằm trong named volume gắn tại /data
HDFS-SITE.XML_dfs.namenode.name.dir=file:///data/hdfs/name
HDFS-SITE.XML_dfs.datanode.data.dir=file:///data/hdfs/data
# Tắt kiểm tra quyền giữa các container (môi trường học)
HDFS-SITE.XML_dfs.permissions.enabled=false
# Bật REST API WebHDFS (bước 1.8)
HDFS-SITE.XML_dfs.webhdfs.enabled=true
# Docker không có reverse DNS cho IP container: tắt kiểm tra này nếu không DataNode bị NameNode từ chối đăng ký
HDFS-SITE.XML_dfs.namenode.datanode.registration.ip-hostname-check=false
# Danh sách DataNode cần decommission (bước 1.9). File mount từ docker/hadoop/exclude/
HDFS-SITE.XML_dfs.hosts.exclude=/opt/hadoop-exclude/dfs.exclude

# Heap JVM nhỏ hơn mem_limit của container để chừa chỗ cho bộ nhớ ngoài heap
HADOOP_HEAPSIZE_MAX=512m
